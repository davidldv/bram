OPENROUTER_API_KEY=sk-or-v1-xxxxx
OPENROUTER_BACKUP_KEY=
OPENROUTER_BACKUP_KEY2=
NEWS_API_KEY=xxxxx
OPENROUTER_MODEL=openai/gpt-oss-120b:free
PORT=3000
RATE_LIMIT_MAX=30
# Supabase project URL (same as app.json > expo.extra.supabaseUrl). Used to verify
# user JWTs against the project's JWKS. If unset, endpoints are open to anyone
# with the URL — dev only.
SUPABASE_URL=https://xxxxx.supabase.co
