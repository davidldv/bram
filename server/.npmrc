# pnpm config.
# hoisted layout: required for React Native / Metro (in app/) and harmless here.
node-linker=hoisted
# Keep pnpm's default security posture: dependency build scripts are blocked
# unless explicitly allow-listed via package.json > pnpm.onlyBuiltDependencies.
# 7-day cooldown before resolving newly published versions (supply-chain hardening).
# npm reads this; pnpm enforces the equivalent minimumReleaseAge in pnpm-workspace.yaml.
min-release-age = 7
